% *** Barras 3D para gráfico de afluencia semanal ***
% Uso: \barraTresD{posición X}{valor Y}{color}{etiqueta}
\newcommand{\barraTresD}[4]{%
    \def\px{0.3}%
    \def\py{5}%
    \def\ancho{0.3}%
    % Cara frontal
    \draw[fill=#3!80, draw=#3!50!black, thick]
        (#1-\ancho, 0) rectangle (#1+\ancho, #2);
    % Cara lateral derecha
    \draw[fill=#3!95!black, draw=#3!50!black, thick]
        (#1+\ancho, 0) --
        (#1+\ancho+\px, \py) --
        (#1+\ancho+\px, #2+\py) --
        (#1+\ancho, #2) -- cycle;
    % Cara superior
    \draw[fill=#3!50, draw=#3!50!black, thick]
        (#1-\ancho, #2) --
        (#1-\ancho+\px, #2+\py) --
        (#1+\ancho+\px, #2+\py) --
        (#1+\ancho, #2) -- cycle;
    % Etiqueta inferior
    \node[below, font=\scriptsize\sffamily, text=black!80] at (#1, -4) {#4};
}

% ============================================================
% *** Diagramas de arquitectura del sistema (Capítulo II) ***
% ============================================================

% --- Estilos de conexión ---
\tikzset{
    spflow/.style={
        -{Stealth[length=2.2mm, width=1.6mm]},
        draw=black!65, line width=0.7pt
    },
    spboth/.style={
        {Stealth[length=1.8mm, width=1.4mm]}-{Stealth[length=1.8mm, width=1.4mm]},
        draw=black!65, line width=0.6pt
    }
}

% --- Contenedor de capa arquitectónica ---
% Uso: \spLayer{nombre}{coordenada sin paréntesis}{ancho}{alto}{color}{etiqueta}
\newcommand{\spLayer}[6]{%
    \node[draw=#5!60!black, dashed, rounded corners=3pt, fill=#5!30,
          inner sep=0pt, minimum width=#3, minimum height=#4,
          line width=0.6pt] (#1) at (#2) {};
    \node[anchor=north west, font=\scriptsize\bfseries\sffamily,
          text=#5!45!black, inner sep=0pt]
        at ([xshift=5pt, yshift=-4pt]#1.north west) {#6};
}

% --- Bloque de componente ---
% Uso: \spBlock{nombre}{coordenada sin paréntesis}{ancho}{color}{título}{subtítulo}
% Nota: el subtítulo puede contener varias líneas separadas con \\.
\newcommand{\spBlock}[6]{%
    \node[draw=#4!65!black, fill=#4!30, rounded corners=2pt,
          minimum width=#3, minimum height=0.95cm, align=center,
          font=\scriptsize\sffamily, inner sep=2pt, line width=0.5pt]
        (#1) at (#2) {\textbf{#5}\\[1pt]\tiny\itshape #6};
}

% --- Píldora de dato intermedio ---
% Uso: \spData{nombre}{coordenada sin paréntesis}{texto}
\newcommand{\spData}[3]{%
    \node[draw=black!45, fill=yellow!18, rounded corners=6pt,
          inner sep=2.5pt, font=\tiny\itshape, text=black!75]
        (#1) at (#2) {#3};
}

% --- Entidad del modelo de datos ---
% Uso: \spEntity{nombre}{coordenada sin paréntesis}{ancho}{color}{título}{campos}
% Nota: los campos se separan con \\ y los guiones bajos deben escaparse (\_).
\newcommand{\spEntity}[6]{%
    \node[draw=#4!70!black, fill=#4!25, rounded corners=2pt,
          minimum width=#3, align=center, inner sep=4pt,
          font=\scriptsize\sffamily, line width=0.6pt]
        (#1) at (#2) {\textbf{#5}\\[2pt]\tiny #6};
}

% ============================================================
% *** Wireframes de interfaz (Capítulo II) ***
% ============================================================

% --- Marco de pantalla ---
% Uso: \spScreen{nombre}{coordenada sin paréntesis}{ancho}{alto}{título}
% Las dimensiones se expresan en centímetros.
\newcommand{\spScreen}[5]{%
    \draw[draw=black!60, fill=white, rounded corners=3pt, line width=0.7pt]
        ($(#2)+(-#3/2,-#4/2)$) rectangle ($(#2)+(#3/2,#4/2)$);
    \draw[draw=black!60, fill=black!10, line width=0.7pt]
        ($(#2)+(-#3/2,#4/2)$) rectangle ($(#2)+(#3/2,#4/2-0.42)$);
    \node[anchor=west, font=\tiny\bfseries\sffamily, text=black!70, inner sep=0pt]
        at ($(#2)+(-#3/2+0.12,#4/2-0.21)$) {#5};
    \coordinate (#1) at (#2);
}

% --- Panel interno ---
% Uso: \spPanel{coordenada sin paréntesis}{ancho}{alto}{título}
\newcommand{\spPanel}[4]{%
    \draw[draw=black!35, fill=black!4, line width=0.5pt]
        ($(#1)+(-#2/2,-#3/2)$) rectangle ($(#1)+(#2/2,#3/2)$);
    \node[anchor=north west, font=\tiny\sffamily, text=black!60, inner sep=0pt]
        at ($(#1)+(-#2/2+0.09,#3/2-0.09)$) {#4};
}

% --- Campo o botón esquemático ---
% Uso: \spField{coordenada sin paréntesis}{ancho}{texto}
\newcommand{\spField}[3]{%
    \node[draw=black!40, fill=white, rounded corners=1pt, line width=0.4pt,
          minimum width=#2, minimum height=0.26cm, font=\tiny\sffamily,
          text=black!65, inner sep=1.5pt] at (#1) {#3};
}

% --- Etiqueta de estado ---
% Uso: \spBadge{coordenada sin paréntesis}{color}{texto}
\newcommand{\spBadge}[3]{%
    \node[draw=#2!70!black, fill=#2!22, rounded corners=2pt, line width=0.4pt,
          minimum height=0.26cm, font=\tiny\bfseries\sffamily,
          text=#2!45!black, inner sep=2.5pt] at (#1) {#3};
}

